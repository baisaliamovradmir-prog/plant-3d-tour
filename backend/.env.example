# Docker Compose reads .env automatically. Local manage.py uses shell variables.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=plant_tour
POSTGRES_USER=plant_tour
# Local HTTP demo. Set false behind HTTPS for deployment.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000
BACKEND_PORT=8000
SEED_DEMO=true
# Optional: creates demo_visitor/demo_manager/demo_editor/demo_admin.
# Use a unique strong password. Empty = no demo users.
DEMO_PASSWORD=
